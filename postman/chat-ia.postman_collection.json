                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('responde status ok', () => {",
                  "    pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Liveness check. Sem autenticação. Fase 2."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201 (ou 409 se já cadastrado)', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.test('devolve id e username', () => {",
                  "        pm.expect(body).to.have.property('id');",
                  "        pm.expect(body.username).to.eql(pm.environment.get('username'));",
                  "    });",
                  "    pm.test('NUNCA devolve senha nem hash', () => {",
                  "        pm.expect(body).to.not.have.property('password');",
                  "        pm.expect(body).to.not.have.property('password_hash');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "description": "Cadastra um usuário. 201 Created. 409 se o username já existe. Fase 2."
          }
        },
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('devolve access_token bearer', () => {",
                  "    pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.token_type).to.eql('bearer');",
                  "});",
                  "",
                  "// Salva o token para as demais requisições da coleção.",
                  "pm.environment.set('access_token', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Autentica e devolve o JWT. O script de teste salva o token em {{access_token}}. Fase 2/3."
          }
        },
        {
          "name": "POST /auth/login — senha errada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('não revela se o usuário existe', () => {",
                  "    const detail = pm.response.json().detail.toLowerCase();",
                  "    pm.expect(detail).to.include('inválidos');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"senha-propositalmente-errada\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Caso negativo. A mensagem é a mesma de 'usuário inexistente', de propósito: mensagens distintas permitiriam enumerar contas válidas."
          }
        },
        {
          "name": "GET /auth/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('devolve o usuário do token', () => {",
                  "    pm.expect(pm.response.json().username).to.eql(pm.environment.get('username'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] },
            "description": "Dados do usuário autenticado. Requer Bearer token. Fase 3."
          }
        },
        {
          "name": "GET /auth/me — sem token",
          "event": [
