# =============================================================
# Copie este arquivo para .env e preencha os valores reais.
#   cp .env.example .env
# O .env está no .gitignore e NUNCA deve ser commitado.
# =============================================================

# ---- Banco de dados (PostgreSQL) ----
# Credenciais usadas pelo container do Postgres no docker-compose.
POSTGRES_USER=chatia
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=chatia

# String de conexão usada pelo backend (SQLAlchemy).
# Dentro do docker-compose o host é o nome do serviço: "db".
# Rodando o backend fora do Docker, use: localhost:5432
DATABASE_URL=postgresql+psycopg2://chatia:troque-esta-senha@db:5432/chatia

# ---- Autenticação (JWT) ----
# Gere um valor forte com: openssl rand -hex 32
JWT_SECRET_KEY=gere-uma-chave-aleatoria-de-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- LLM (Google AI Studio / Gemini) ----
# Obtenha em https://aistudio.google.com/apikey
# Esta chave vive SOMENTE no backend. Jamais no frontend.
GEMINI_API_KEY=

# Nomes de modelo expiram. Se a API responder 404 dizendo que o modelo
# "is no longer available", a própria mensagem indica o substituto — e a
# lista atual sai de:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
#
# Alternativa: gemini-flash-latest, um alias que nunca expira mas cuja
# versão muda sob os seus pés (hoje aponta para o gemini-3.8-flash).
GEMINI_MODEL=gemini-3.6-flash

# ---- Fotos das receitas ----
# Onde o backend grava as fotos enviadas. No docker-compose já vale
# /app/media, montado no volume media-data; só mude rodando fora do Docker.
# MEDIA_DIR=media

# ---- CORS ----
# Origem(ns) do frontend autorizadas a chamar a API, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
# Variáveis NEXT_PUBLIC_* são embutidas no bundle e ficam VISÍVEIS no navegador.
# Por isso aqui só entra a URL pública da API — nunca uma chave.
NEXT_PUBLIC_API_URL=http://localhost:8000
