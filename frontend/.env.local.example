# Copie para .env.local e ajuste se necessário.
#
# ATENÇÃO: variáveis NEXT_PUBLIC_* são embutidas no bundle JavaScript e ficam
# legíveis para qualquer pessoa que abra o DevTools. Aqui só pode entrar valor
# público — a chave da Gemini vive no backend, jamais neste arquivo.

NEXT_PUBLIC_API_URL=http://localhost:8000
